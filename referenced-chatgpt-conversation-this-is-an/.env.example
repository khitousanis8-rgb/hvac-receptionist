# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Business configuration — use actual approved company information before deployment.
BUSINESS_COMPANY_NAME=Example HVAC
BUSINESS_PHONE=+15555550100
BUSINESS_ADDRESS=123 Example Street, Example City, NY 10001
BUSINESS_TIMEZONE=America/New_York
BUSINESS_EMERGENCY_PHONE=+15555550199
BUSINESS_OPENING_HOURS={"monday":"09:00-17:00","tuesday":"09:00-17:00","wednesday":"09:00-17:00","thursday":"09:00-17:00","friday":"09:00-17:00","saturday":"closed","sunday":"closed"}
BUSINESS_SERVICES=AC repair,AC installation,Furnace repair,Furnace installation,Heat pump service,Preventive maintenance

# LiveKit — required when running the agent worker and for POST /v1/calls/token.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Leave false for the in-browser Kokoro voice flow. Set true only when you
# intentionally run the legacy LiveKit worker as well.
ENABLE_LIVEKIT_WORKER=false

# LLM — any OpenAI-compatible Chat Completions endpoint.
# Default: Groq (free tier, fast, open-weight models). Get a key at https://console.groq.com
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Local alternative (Ollama): no API key needed.
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b
